# Leave empty in development: requests go to /api on the Vite dev server,
# which proxies them to VITE_PROXY_TARGET (the backend has no CORS support).
VITE_API_BASE_URL=

# Where the Vite dev server forwards /api requests (your Spring Boot backend)
VITE_PROXY_TARGET=http://localhost:8080

# AI features: keep false until the backend exposes the AI endpoints
# documented in BACKEND_API_REFERENCE.md
VITE_AI_ENABLED=false

# Display options
VITE_CURRENCY=INR
VITE_LOCALE=en-IN
